{
  "name": "@xh/hoist-chat-kit",
  "version": "4.0.0-SNAPSHOT",
  "description": "Chat with LLMs and agents in Hoist React apps: models, streaming transports, desktop components and generative UI.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xh/hoist-chat-kit.git"
  },
  "homepage": "https://xh.io",
  "bugs": "https://github.com/xh/hoist-chat-kit/issues",
  "author": "Extremely Heavy Industries, Inc.",
  "license": "Apache-2.0",
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "CHANGELOG.md",
    "cmp",
    "core",
    "desktop",
    "docs",
    "hoist-docs",
    "genui",
    "impl",
    "styles",
    "threads",
    "transport",
    "!**/*.spec.ts",
    "!**/*.spec.tsx"
  ],
  "hoistDocs": {
    "id": "chat-kit",
    "index": "hoist-docs/index.json.gz",
    "exclude": [
      "test"
    ]
  },
  "scripts": {
    "lint": "pnpm lint:all",
    "lint:all": "pnpm lint:code && pnpm lint:styles && pnpm lint:format",
    "lint:code": "eslint .",
    "lint:styles": "stylelint --allow-empty-input \"**/*.s?(a|c)ss\"",
    "lint:format": "prettier --check .",
    "typecheck": "tsc",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "build": "node scripts/check-package.mjs",
    "prepare": "husky",
    "prepack": "hoist-docs-build --root . --file hoist-docs/index.json.gz"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,mjs,mts}": [
      "prettier --write",
      "eslint"
    ],
    "*.s?(a|c)ss": [
      "prettier --write",
      "stylelint"
    ]
  },
  "peerDependencies": {
    "@xh/hoist": ">=91.0.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/lodash": "^4.17.27",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitest/ui": "^5.1.1",
    "@xh/eslint-config": "^8.1.0",
    "@xh/hoist": "^91.0.0",
    "@xh/hoist-dev-utils": "^16.5.0",
    "@xh/hoist-docs-builder": "^1.0.0",
    "ag-grid-community": "~36.3.0",
    "ag-grid-react": "~36.3.0",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.14.0",
    "husky": "^9.1.7",
    "jsdom": "^31.0.1",
    "lint-staged": "^17.6.1",
    "msw": "^3.0.7",
    "prettier": "^3.10.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "stylelint": "^18.1.0",
    "stylelint-config-recommended-scss": "^18.0.0",
    "type-fest": "^5.10.0",
    "typescript": "^7.0.2",
    "vitest": "^5.1.1"
  },
  "packageManager": "pnpm@12.23.0",
  "dependencies": {
    "@ag-ui/client": "1.0.5",
    "@ag-ui/core": "1.0.5",
    "classnames": "^2.5.1",
    "lodash": "^4.18.1",
    "rxjs": "7.8.1",
    "zod": "^4.6.7"
  }
}
