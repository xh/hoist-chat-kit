{
  "name": "@xh/hoist-chat-kit",
  "version": "2.0.0-SNAPSHOT",
  "description": "Chat with LLMs and agents in Hoist React apps: models, streaming transports, desktop components and generative UI.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xh/hoist-chat-kit.git"
  },
  "homepage": "https://xh.io",
  "bugs": "https://github.com/xh/hoist-chat-kit/issues",
  "author": "Extremely Heavy Industries, Inc.",
  "license": "Apache-2.0",
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "CHANGELOG.md",
    "cmp",
    "core",
    "desktop",
    "docs",
    "genui",
    "impl",
    "styles",
    "threads",
    "transport",
    "!**/*.spec.ts",
    "!**/*.spec.tsx"
  ],
  "hoist": {
    "docRegistry": "docs/doc-registry.json"
  },
  "scripts": {
    "lint": "pnpm lint:all",
    "lint:all": "pnpm lint:code && pnpm lint:styles && pnpm lint:format",
    "lint:code": "eslint .",
    "lint:styles": "stylelint --allow-empty-input \"**/*.s?(a|c)ss\"",
    "lint:format": "prettier --check .",
    "typecheck": "tsc",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "build": "node scripts/check-package.mjs",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,mjs,mts}": [
      "prettier --write",
      "eslint"
    ],
    "*.s?(a|c)ss": [
      "prettier --write",
      "stylelint"
    ]
  },
  "peerDependencies": {
    "@xh/hoist": ">=89.3.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/lodash": "^4.17.27",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitest/ui": "^5.0.5",
    "@xh/eslint-config": "^8.1.0",
    "@xh/hoist": "^89.3.1",
    "@xh/hoist-dev-utils": "^16.1.1",
    "ag-grid-community": "~36.2.0",
    "ag-grid-react": "~36.2.0",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.13.0",
    "husky": "^9.1.7",
    "jsdom": "^30.1.3",
    "lint-staged": "^17.6.0",
    "msw": "^3.0.3",
    "prettier": "^3.9.10",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "stylelint": "^17.16.0",
    "stylelint-config-recommended-scss": "^17.0.1",
    "type-fest": "^5.10.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  },
  "packageManager": "pnpm@12.16.1+sha512.091d1dee7927575661b25dab3c2ae31cafc1c54d6b71ed6a6600cf0c1cb10434a447eae14015f1b23e2e6bedeed79df94a932e2164d2832280dce3fb32f656d1",
  "dependencies": {
    "@ag-ui/client": "1.0.3",
    "@ag-ui/core": "1.0.3",
    "classnames": "^2.5.1",
    "lodash": "^4.18.1",
    "rxjs": "7.8.1"
  }
}
