{
    "widgets": {
        "toolbox.portfolioBuilder": {
            "label": "Portfolio builder",
            "terms": [
                "portfolio builder",
                "hypothetical portfolio",
                "basket",
                "pick tickers"
            ],
            "category": "input",
            "app": true,
            "guidance": "An app widget where a user builds a portfolio from tickers and weights. Its value is a portfolio variable.",
            "config": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                    "maxHoldings": {
                        "type": "integer",
                        "minimum": 1,
                        "maximum": 500
                    }
                }
            },
            "value": {
                "type": "toolbox.portfolio"
            },
            "size": {
                "default": {
                    "w": 4,
                    "h": 8
                }
            },
            "example": {
                "component": "toolbox.portfolioBuilder",
                "config": {
                    "maxHoldings": 50
                }
            }
        }
    },
    "variableTypes": {
        "toolbox.fund": {
            "app": true,
            "matches": "string",
            "guidance": "A fund's identifier, which in Toolbox is its name, such as 'Oak Mount'. Its prompt input shows each fund's name and AUM, and supplies its own choices."
        },
        "toolbox.portfolio": {
            "app": true,
            "matches": "toolbox.portfolio",
            "guidance": "A hypothetical portfolio: {\"holdings\": [{\"symbol\": \"AAPL\", \"weight\": 0.5}]}.",
            "schema": {
                "type": "object",
                "required": ["holdings"],
                "properties": {
                    "holdings": {
                        "type": "array",
                        "items": {
                            "type": "object",
                            "required": ["symbol", "weight"],
                            "properties": {"symbol": {"type": "string"}, "weight": {"type": "number"}}
                        }
                    }
                }
            }
        }
    },
    "resolvers": {
        "toolbox.userFund": {
            "returns": "toolbox.fund",
            "app": true,
            "args": {},
            "guidance": "The current user's own fund."
        }
    },
    "actions": {
        "toolbox.publishToPmPack": {
            "app": true,
            "sideEffects": true,
            "params": {
                "type": "object",
                "required": [
                    "fund",
                    "asOf"
                ],
                "properties": {
                    "fund": {
                        "type": "string",
                        "description": "A fund."
                    },
                    "asOf": {
                        "type": "string",
                        "description": "A localDate, as YYYY-MM-DD."
                    }
                }
            },
            "guidance": "Publishes a report to the PM pack. Always asks the user to confirm."
        }
    },
    "renderers": {
        "toolbox.ticker": {
            "app": true,
            "appliesTo": {
                "kinds": [
                    "ticker"
                ]
            },
            "config": {}
        },
        "toolbox.weatherIcon": {
            "app": true,
            "appliesTo": {
                "kinds": [
                    "condition"
                ]
            },
            "config": {}
        }
    }
}
