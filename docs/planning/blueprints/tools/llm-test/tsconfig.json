{
    "compilerOptions": {
        "target": "ES2023",
        "module": "NodeNext",
        "moduleResolution": "NodeNext",
        "strict": false,
        "jsx": "react",
        "noImplicitAny": false,
        "resolveJsonModule": true,
        "skipLibCheck": true,
        "noEmit": true,
        "allowImportingTsExtensions": true,
        "paths": {"@xh/hoist/*": ["../../../../../../hoist-react/*"]}
    },
    "include": [
        "src"
    ]
}
