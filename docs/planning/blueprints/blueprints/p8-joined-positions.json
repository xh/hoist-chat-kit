{
    "schema": {
        "blueprint": 1,
        "widgets": {"dashboard": 1, "cubeGrid": 1},
        "resolvers": {"previousBusinessDay": 1}
    },
    "variables": {
        "asOf": {"type": "localDate", "label": "As of", "setBy": "prompt", "default": {"resolver": "previousBusinessDay"}}
    },
    "sources": {
        "positions": {
            "dataset": "positions",
            "params": {"asOf": {"$var": "asOf"}},
            "joins": [{"source": "funds", "on": {"fund": "fund"}, "fields": ["manager", "style", "nav"]}],
            "filter": {"field": "style", "op": "=", "value": ["Macro", "Credit"]}
        },
        "funds": {"dataset": "fundSummary", "params": {"asOf": {"$var": "asOf"}}}
    },
    "root": "page",
    "elements": {
        "page": {"component": "panel", "tbar": [{"id": "asOfInput"}], "children": [{"id": "dashboard"}]},
        "asOfInput": {"component": "variableInput", "config": {"variable": "asOf"}},
        "dashboard": {"component": "dashboard", "children": [{"id": "posGrid", "x": 0, "y": 0, "w": 12, "h": 10}]},
        "posGrid": {
            "component": "cubeGrid",
            "config": {
                "source": "positions",
                "title": "Macro and Credit Positions by Manager",
                "groupBy": ["manager", "style", "fund"],
                "columnState": ["nav", "mktVal", "pnlDay"]
            }
        }
    }
}
