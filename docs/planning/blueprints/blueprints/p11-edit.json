{
    "base": 12,
    "description": "Add Oak Mount's headline numbers and note from the chat",
    "ops": [
        {"op": "set", "path": "/variables/fund", "value": {"type": "toolbox.fund", "label": "Fund", "setBy": "prompt", "default": {"value": "Oak Mount"}}},
        {"op": "addElement", "id": "fundInput", "element": {"component": "variableInput", "config": {"variable": "fund"}}, "parent": "page", "slot": "tbar"},
        {"op": "set", "path": "/sources/fundSummary", "value": {"dataset": "fundSummary", "params": {"asOf": {"$var": "asOf"}, "fund": {"$var": "fund"}}}},
        {"op": "addElement", "id": "fundCards", "element": {"component": "tileFrame", "config": {"title": "Fund Today"}}, "parent": "dashboard", "child": {"x": 0, "y": 14, "w": 8, "h": 2}},
        {"op": "addElement", "id": "fundNav", "element": {"component": "statCard", "config": {"source": "fundSummary", "field": "nav"}}, "parent": "fundCards", "child": {}},
        {"op": "addElement", "id": "fundPnlDay", "element": {"component": "statCard", "config": {"source": "fundSummary", "field": "pnlDay", "trend": "pnlHistory"}}, "parent": "fundCards", "child": {}},
        {"op": "addElement", "id": "fundPnlMtd", "element": {"component": "statCard", "config": {"source": "fundSummary", "field": "pnlMtd"}}, "parent": "fundCards", "child": {}},
        {
            "op": "addElement",
            "id": "fundNote",
            "element": {"component": "callout", "config": {"intent": "primary", "title": "Today", "text": "{fund} made {fundSummary.pnlDay} today, which takes its month to {fundSummary.pnlMtd}."}},
            "parent": "dashboard",
            "child": {"x": 8, "y": 14, "w": 4, "h": 2}
        }
    ]
}
